# ─── Copy this file to .env.local and fill in your values ───────────────────

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# OpenAI (CivicBot)
OPENAI_API_KEY=

# Database (e.g. PostgreSQL connection string for Prisma / Drizzle)
DATABASE_URL=

# Auth secret (NextAuth.js or Lucia)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
