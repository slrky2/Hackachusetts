# ─── Copy this file to .env.local and fill in your values ───────────────────

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# OpenAI (CivicBot)
OPENAI_API_KEY=

# Bounties: comma-separated emails of city staff. Signed-in users with one of
# these (verified) emails approve city jobs and can post jobs as the city.
CITY_STAFF_EMAILS=

# Database (e.g. PostgreSQL connection string for Prisma / Drizzle)
DATABASE_URL=

# Auth secret (NextAuth.js or Lucia)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
